<?xml version="1.0" encoding="utf-8"?>
<!--
  The install id must not survive an uninstall. Auto Backup is opt out, so a restored id can land on a resold or
  factory reset device and join a previous owner's installs to a new person. Over counting a reinstall is the
  better failure, so this file is deliberate, not an oversight.

  Android 11 and earlier read this file. Android 12 and later read trace_data_extraction_rules.xml, so any file
  excluded here is excluded there as well. The queued event file joins this list when it exists: it carries the
  same id, so a restored queue would say the same wrong thing. One more exclude line in each file, nothing else.
-->
<full-backup-content>
    <exclude domain="sharedpref" path="io.usetrace.sdk.installid.xml" />
</full-backup-content>
