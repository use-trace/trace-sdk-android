<?xml version="1.0" encoding="utf-8"?>
<!--
  The Android 12 and later form of trace_backup_rules.xml, for the same reason: a restored install id would join a
  previous owner's installs to a new person.

  Both sections are needed. cloud-backup covers a restore onto a new or reset device, device-transfer covers a
  direct phone to phone copy, which is the resold or handed on phone this exclusion exists for, so excluding from
  one and not the other defeats the point.

  The queued event file joins both lists when it exists, as one more exclude line in each section, for the same
  reason: it carries the install id.

  The file is named for this library rather than data_extraction_rules.xml, because a host app's resource of the
  same name would replace it during resource merge without saying so.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="io.usetrace.sdk.installid.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="io.usetrace.sdk.installid.xml" />
    </device-transfer>
</data-extraction-rules>
